# Defina os valores de produção em Settings > Environment Variables na Vercel.
# Nunca envie valores secretos no Git ou no chat.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TRACKER_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
# O cron da Vercel está fixado em 12:00 UTC = 09:00 de Fortaleza.
TRACKER_TIMEZONE=America/Fortaleza
