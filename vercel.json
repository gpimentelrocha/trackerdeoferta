{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "excludeFiles": "{test/**,data/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "crons": [{ "path": "/api/cron", "schedule": "0 12 * * *" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ]
  }]
}
